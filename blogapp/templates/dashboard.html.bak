<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PeakShift - Industrial power cost and carbon optimization system</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/dashboard.css') }}?v={{ cache_bust }}">
    
    <!-- Global music player styles -->
    <link rel="stylesheet" href="{{ url_for('static', filename='music-player/css/music-player.css') }}">
</head>
<body data-playlist="playlist-dashboard">
    <!-- Main container -->
    <div id="app" class="d-flex flex-column min-vh-100">
        
        <!-- Flash messages - centered at top -->
        <div id="flashMessagesContainer" class="position-fixed start-50 translate-middle-x" style="z-index: 9999; min-width: 300px; top: 80px;">
            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}
                    {% for category, message in messages %}
                        <div class="flash-message flash-{{ category }}" role="alert">
                            <div class="flash-icon">
                                {% if category == 'success' %}
                                    <i class="bi bi-check-circle-fill"></i>
                                {% elif category == 'danger' or category == 'error' %}
                                    <i class="bi bi-exclamation-circle-fill"></i>
                                {% elif category == 'warning' %}
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                {% else %}
                                    <i class="bi bi-info-circle-fill"></i>
                                {% endif %}
                            </div>
                            <div class="flash-content">
                                <div class="flash-text">{{ message }}</div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            {% endwith %}
        </div>
        
        <!-- Top navigation bar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" href="#">
                    <i class="bi bi-lightning-charge-fill me-2"></i>
                    <span class="fw-bold">PeakShift</span>
                </a>
                
                <div class="d-flex align-items-center gap-3">
                    <!-- FPS display -->
                    <div id="fpsDisplay" class="text-white small" style="display: none;">
                        <i class="bi bi-speedometer2 me-1"></i>
                        <span id="fpsValue">--</span> FPS
                    </div>
                    
                    <!-- Settings button -->
                    <button class="btn btn-outline-light btn-sm" onclick="openSettings()" title="Settings">
                        <i class="bi bi-gear-fill"></i>
                    </button>
                    
                    <span class="text-white">
                        <i class="bi bi-person-circle me-1"></i>
                        {{ current_user.username }}
                    </span>
                    <a href="{{ url_for('auth.logout') }}" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Log out
                    </a>
                </div>
            </div>
        </nav>

        <!-- Main content area -->
        <div class="flex-grow-1">
            
            <!-- Factory management view -->
            <div id="factoryManagementView" class="view-container active">
                <div class="container py-3">
                    <div class="row mb-3 align-items-center">
                        <div class="col">
                            <h2 class="mb-1">
                                <i class="bi bi-building me-2"></i>
                                Factory management
                            </h2>
                            <p class="text-muted mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Manage your factory information, view power data and cost analysis
                            </p>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-primary" onclick="showCreateFactoryModal()">
                                <i class="bi bi-plus-circle me-2"></i>
                                Create Factory
                            </button>
                        </div>
                    </div>

                    <!-- Factory list -->
                    <div id="factoryList" class="row g-3">
                        <!-- Factory cards are loaded dynamically by JavaScript -->
                    </div>

                    <!-- Empty state -->
                    <div id="emptyState" class="text-center py-5" style="display: none;">
                        <i class="bi bi-building text-muted" style="font-size: 5rem;"></i>
                        <h4 class="mt-4 mb-2 text-muted">No factories yet</h4>
                        <p class="text-muted mb-4">Click the "Create Factory" button to create your first factory</p>
                        <button class="btn btn-primary" onclick="showCreateFactoryModal()">
                            <i class="bi bi-plus-circle me-2"></i>
                            Create now
                        </button>
                    </div>
                </div>
            </div>

            <!-- Factory details view -->
            <div id="factoryDetailsView" class="view-container">
                <div class="container py-3">
                    <!-- Back button -->
                    <div class="mb-3">
                        <button class="btn btn-outline-secondary btn-sm" onclick="showFactoryManagement()">
                            <i class="bi bi-arrow-left me-2"></i>
                            Return to factory list
                        </button>
                    </div>

                    <!-- Factory info card -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-start justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="factory-icon-large">
                                                <i class="bi bi-building"></i>
                                            </div>
                                            <div>
                                                <h3 class="mb-0" style="font-size: 1.25rem;" id="detailFactoryName">-</h3>
                                                <p class="text-muted mb-0" style="font-size: 0.8125rem;">
                                                    <i class="bi bi-geo-alt me-1"></i>
                                                    <span id="detailFactoryLocation">-</span>
                                                    <span class="mx-2">|</span>
                                                    <i class="bi bi-briefcase me-1"></i>
                                                    <span id="detailFactoryIndustry">-</span>
                                                </p>
                                            </div>
                                        </div>
                                        <button class="btn btn-outline-primary btn-sm" onclick="editCurrentFactory()">
                                            <i class="bi bi-pencil me-1"></i>
                                            Edit
                                        </button>
                                    </div>
                                    
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <div class="detail-info-item">
                                                <div class="detail-label">Voltage level</div>
                                                <div class="detail-value" id="detailVoltageLevel">-</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="detail-info-item">
                                                <div class="detail-label">Transformer capacity</div>
                                                <div class="detail-value" id="detailTransformerCapacity">-</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="detail-info-item">
                                                <div class="detail-label">Daily usage</div>
                                                <div class="detail-value" id="detailDailyUsage">-</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="detail-info-item">
                                                <div class="detail-label">Working days per month</div>
                                                <div class="detail-value" id="detailWorkingDays">-</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Core data overview -->
                    <div class="row g-3 mb-3">
                        <!-- Today’s usage -->
                        <div class="col-md-3">
                            <div class="stat-card stat-card-primary">
                                <div class="stat-icon">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label">Today's usage</div>
                                    <div class="stat-value" id="statTodayUsage">-</div>
                                    <div class="stat-unit">kWh</div>
                                </div>
                            </div>
                        </div>

                        <!-- Monthly cost -->
                        <div class="col-md-3">
                            <div class="stat-card stat-card-warning">
                                <div class="stat-icon">
                                    <i class="bi bi-currency-yen"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label">Monthly cost</div>
                                    <div class="stat-value" id="statMonthCost">-</div>
                                    <div class="stat-unit">CNY</div>
                                </div>
                            </div>
                        </div>

                        <!-- Carbon footprint -->
                        <div class="col-md-3">
                            <div class="stat-card stat-card-success">
                                <div class="stat-icon">
                                    <i class="bi bi-tree-fill"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label">Carbon footprint</div>
                                    <div class="stat-value" id="statCarbonEmission">-</div>
                                    <div class="stat-unit">kg CO₂</div>
                                </div>
                            </div>
                        </div>

                        <!-- Saving potential -->
                        <div class="col-md-3">
                            <div class="stat-card stat-card-info">
                                <div class="stat-icon">
                                    <i class="bi bi-piggy-bank-fill"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label">
                                        Saving potential
                                        <div class="btn-group btn-group-sm ms-2" role="group" id="optimizationModeGroup">
                                            <input type="radio" class="btn-check" name="optimizationMode" id="modeCost" value="cost" checked>
                                            <label class="btn btn-outline-primary btn-xs" for="modeCost" onclick="switchOptimizationMode('cost')">Cost</label>
                                            
                                            <input type="radio" class="btn-check" name="optimizationMode" id="modeCarbon" value="carbon">
                                            <label class="btn btn-outline-success btn-xs" for="modeCarbon" onclick="switchOptimizationMode('carbon')">Carbon</label>
                                        </div>
                                    </div>
                                    <div class="stat-value" id="statSavingPotential">
                                        <span class="text-muted small">Pending backend implementation</span>
                                    </div>
                                    <div class="stat-unit" id="statSavingUnit">-</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart area -->
                    <div class="row g-3 mb-3">
                        <!-- Real-time price chart - single-row layout -->
                        <div class="col-12">
                            <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.25) !important; backdrop-filter: blur(40px) saturate(220%); -webkit-backdrop-filter: blur(40px) saturate(220%);">
                                <div class="card-body p-3" style="background: transparent !important;">
                                    <h5 class="card-title mb-3" style="font-size: 1rem;">
                                        <i class="bi bi-graph-up me-2"></i>
                                        Real-time price chart
                                    </h5>
                                    <div style="height: 280px;">
                                        <canvas id="priceChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pie chart and cost report -->
                    <div class="row g-3 mb-3">
                        <!-- Energy mix pie chart -->
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.25) !important; backdrop-filter: blur(40px) saturate(220%); -webkit-backdrop-filter: blur(40px) saturate(220%);">
                                <div class="card-body p-3" style="background: transparent !important;">
                                    <h5 class="card-title mb-3" style="font-size: 1rem;">
                                        <i class="bi bi-pie-chart-fill me-2"></i>
                                        Energy mix pie chart
                                    </h5>
                                    <div style="height: 280px;">
                                        <canvas id="energyPieChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cost report table -->
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.25) !important; backdrop-filter: blur(40px) saturate(220%); -webkit-backdrop-filter: blur(40px) saturate(220%);">
                                <div class="card-body p-3" style="background: transparent !important;">
                                    <h5 class="card-title mb-3" style="font-size: 1rem;">
                                        <i class="bi bi-calculator me-2"></i>
                                        Cost report
                                    </h5>
                                    <div id="costReportContent">
                                        <!-- Cost report content will be loaded dynamically by JavaScript -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Optimization suggestions -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.25) !important; backdrop-filter: blur(40px) saturate(220%); -webkit-backdrop-filter: blur(40px) saturate(220%);">
                                <div class="card-body p-3" style="background: transparent !important;">
                                    <h5 class="card-title mb-3" style="font-size: 1rem;">
                                        <i class="bi bi-lightbulb me-2"></i>
                                        Optimization suggestions
                                    </h5>
                                    <div id="optimizationContent">
                                        <div class="text-center py-4 text-muted">
                                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <span>Loading optimization suggestions...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Create/Edit factory modal -->
    <div class="modal fade" id="createFactoryModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="factoryModalTitle">
                        <i class="bi bi-plus-circle me-2"></i>
                        Create Factory
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="createFactoryForm">
                        <!-- Basic information -->
                        <div class="mb-3">
                            <label for="factoryName" class="form-label">Factory name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="factoryName" required placeholder="e.g. Beijing Aluminum Electrolyzer">
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="factoryLocation" class="form-label">Factory location</label>
                                <input type="text" class="form-control" id="factoryLocation" placeholder="e.g. Chaoyang District, Beijing">
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label for="industryType" class="form-label">Industry type</label>
                                <select class="form-select" id="industryType">
                                    <option value="">Please select</option>
                                    <option value="Aluminum Smelting">Aluminum Smelting</option>
                                    <option value="Steel">Steel</option>
                                    <option value="Cement">Cement</option>
                                    <option value="Chemical">Chemical</option>
                                    <option value="Coal Refining">Coal Refining</option>
                                    <option value="Textile">Textile</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Power parameters -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="voltageLevel" class="form-label">Voltage level <span class="text-danger">*</span></label>
                                <select class="form-select" id="voltageLevel" required>
                                    <option value="">Please select</option>
                                    <option value="10">10 kV</option>
                                    <option value="35">35 kV</option>
                                    <option value="110">110 kV</option>
                                    <option value="220">220 kV</option>
                                </select>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label for="transformerCapacity" class="form-label">Transformer capacity (kVA) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="transformerCapacity" required step="100" min="0" placeholder="e.g. 5000">
                            </div>
                        </div>
                        
                        <!-- Electricity usage information -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="dailyUsage" class="form-label">Daily usage (kWh/day) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="dailyUsage" required step="1000" min="0" placeholder="e.g. 50000">
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label for="workingDays" class="form-label">Working days per month <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="workingDays" required min="1" max="31" value="26" placeholder="e.g. 26">
                            </div>
                        </div>
                        
                        <!-- Work periods -->
                        <div class="mb-3">
                            <label class="form-label">Work periods <span class="text-danger">*</span></label>
                            <div class="card">
                                <div class="card-body">
                                    <div class="row g-2 mb-2">
                                        <div class="col-5">
                                            <select class="form-select form-select-sm" id="periodStart">
                                                <option value="">Start time</option>
                                                <option value="0">00:00</option>
                                                <option value="1">01:00</option>
                                                <option value="2">02:00</option>
                                                <option value="3">03:00</option>
                                                <option value="4">04:00</option>
                                                <option value="5">05:00</option>
                                                <option value="6">06:00</option>
                                                <option value="7">07:00</option>
                                                <option value="8" selected>08:00</option>
                                                <option value="9">09:00</option>
                                                <option value="10">10:00</option>
                                                <option value="11">11:00</option>
                                                <option value="12">12:00</option>
                                                <option value="13">13:00</option>
                                                <option value="14">14:00</option>
                                                <option value="15">15:00</option>
                                                <option value="16">16:00</option>
                                                <option value="17">17:00</option>
                                                <option value="18">18:00</option>
                                                <option value="19">19:00</option>
                                                <option value="20">20:00</option>
                                                <option value="21">21:00</option>
                                                <option value="22">22:00</option>
                                                <option value="23">23:00</option>
                                            </select>
                                        </div>
                                        <div class="col-auto d-flex align-items-center">
                                            <span>to</span>
                                        </div>
                                        <div class="col-5">
                                            <select class="form-select form-select-sm" id="periodEnd">
                                                <option value="">End time</option>
                                                <option value="1">01:00</option>
                                                <option value="2">02:00</option>
                                                <option value="3">03:00</option>
                                                <option value="4">04:00</option>
                                                <option value="5">05:00</option>
                                                <option value="6">06:00</option>
                                                <option value="7">07:00</option>
                                                <option value="8">08:00</option>
                                                <option value="9">09:00</option>
                                                <option value="10">10:00</option>
                                                <option value="11">11:00</option>
                                                <option value="12">12:00</option>
                                                <option value="13">13:00</option>
                                                <option value="14">14:00</option>
                                                <option value="15">15:00</option>
                                                <option value="16">16:00</option>
                                                <option value="17">17:00</option>
                                                <option value="18" selected>18:00</option>
                                                <option value="19">19:00</option>
                                                <option value="20">20:00</option>
                                                <option value="21">21:00</option>
                                                <option value="22">22:00</option>
                                                <option value="23">23:00</option>
                                                <option value="24">24:00</option>
                                            </select>
                                        </div>
                                        <div class="col-auto">
                                            <button type="button" class="btn btn-sm btn-primary" onclick="addWorkPeriod()">
                                                <i class="bi bi-plus-circle"></i> Add
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <div id="workPeriodsList" class="mt-2">
                                        <!-- Added periods will appear here -->
                                    </div>
                                    
                                    <div class="form-text">
                                        <i class="bi bi-info-circle"></i> 
                                        Add factory work periods, e.g. 8:00-12:00, 13:00-18:00
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="factorySubmitBtn" onclick="createFactory()">
                        <i class="bi bi-check-circle me-1"></i>
                        Create
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Settings panel modal -->
    <div class="modal fade" id="settingsModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-gear-fill me-2"></i>
                        System settings
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- UI mode selection -->
                    <div class="mb-4">
                        <h6 class="mb-3">
                            <i class="bi bi-palette me-2"></i>
                            UI mode
                        </h6>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="uiMode" id="uiModeFull" value="full" checked>
                            <label class="btn btn-outline-primary" for="uiModeFull">
                                <i class="bi bi-stars me-1"></i>
                                Full mode
                            </label>
                            
                            <input type="radio" class="btn-check" name="uiMode" id="uiModeLite" value="lite">
                            <label class="btn btn-outline-primary" for="uiModeLite">
                                <i class="bi bi-lightning me-1"></i>
                                Lite mode
                            </label>
                        </div>
                        <div class="form-text mt-2">
                            Full mode: full effects, suitable for high-performance devices<br>
                            Lite mode: reduced animation, suitable for low-performance devices
                        </div>
                    </div>
                    
                    <!-- Performance benchmark test -->
                    <div class="mb-4">
                        <h6 class="mb-3">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Performance test
                        </h6>
                        <button class="btn btn-primary w-100" id="benchmarkBtn" onclick="runBenchmark()">
                            <i class="bi bi-play-circle me-1"></i>
                            Start benchmark test (10 seconds)
                        </button>
                        <div id="benchmarkResult" class="mt-3" style="display: none;">
                            <div class="alert" id="benchmarkAlert">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-speedometer2 me-2" style="font-size: 1.5rem;"></i>
                                    <div>
                                        <strong>Average FPS: <span id="avgFps">--</span></strong><br>
                                        <strong>Minimum FPS: <span id="minFps">--</span></strong><br>
                                        <small id="recommendation">--</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- FPS display toggle -->
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="showFpsToggle" onchange="toggleFpsDisplay()">
                            <label class="form-check-label" for="showFpsToggle">
                                Show real-time FPS
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="saveSettings()">
                        <i class="bi bi-check-circle me-1"></i>
                        Save settings
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Auto-dismiss Flash Messages -->
    <script>
        // Auto-close flash messages (after 5 seconds)
        document.addEventListener('DOMContentLoaded', function() {
            const flashMessages = document.querySelectorAll('#flashMessagesContainer .flash-message');
            flashMessages.forEach(function(message) {
                // Add fade-in animation
                setTimeout(function() {
                    message.style.opacity = '1';
                    message.style.transform = 'translateY(0)';
                }, 10);
                
                // Fade out and remove after 5 seconds
                setTimeout(function() {
                    message.style.opacity = '0';
                    message.style.transform = 'translateY(-20px)';
                    setTimeout(function() {
                        message.remove();
                    }, 300);
                }, 5000);
            });
        });
    </script>
    
    <!-- Custom JS -->
    <script src="{{ url_for('static', filename='js/dashboard.js') }}?v={{ cache_bust }}"></script>
    
    <!-- Global music player script -->
    <script src="{{ url_for('static', filename='music-player/js/music-player.js') }}"></script>
</body>
</html>
